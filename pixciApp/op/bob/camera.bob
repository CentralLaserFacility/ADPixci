<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <macros>
    <CAM>13PS1</CAM>
  </macros>
  <width>870</width>
  <height>565</height>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <x>20</x>
    <y>65</y>
    <width>465</width>
    <height>28</height>
    <line_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </line_color>
    <background_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
  </widget>
  <widget type="image" version="2.0.0">
    <name>Image</name>
    <pv_name>$(CAM):image1:ArrayData</pv_name>
    <x>5</x>
    <y>65</y>
    <width>480</width>
    <height>480</height>
    <show_toolbar>true</show_toolbar>
    <color_map>
      <name>GRAY</name>
    </color_map>
    <color_bar>
      <visible>false</visible>
      <bar_size>40</bar_size>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </color_bar>
    <x_axis>
      <visible>true</visible>
      <title></title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </x_axis>
    <y_axis>
      <visible>true</visible>
      <title></title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </y_axis>
    <rules>
      <rule name="AutoScale" prop_id="autoscale" out_exp="false">
        <exp bool_exp="pv0==0">
          <value>false</value>
        </exp>
        <exp bool_exp="pv1==1">
          <value>true</value>
        </exp>
        <pv_name>loc://AutoScale&lt;Long&gt;(1)</pv_name>
      </rule>
      <rule name="ColourMap" prop_id="color_map" out_exp="false">
        <exp bool_exp="true">
          <value>
            <name>JET</name>
          </value>
        </exp>
        <exp bool_exp="pvStr0 == &quot;JET&quot;">
          <value>
            <name>JET</name>
          </value>
        </exp>
        <exp bool_exp="pvStr0 != &quot;JET&quot;">
          <value>
            <name>GRAY</name>
          </value>
        </exp>
        <pv_name>loc://ColourMap&lt;VString&gt;("GRAY")</pv_name>
      </rule>
    </rules>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

# widget.setPropertyValue('text', PVUtil.getString(pvs[0]))

default_dimension = 480
sizex = PVUtil.getLong(pvs[0])
sizey = PVUtil.getLong(pvs[1])
widget_sizex = default_dimension
widget_sizey = default_dimension
autoScale = PVUtil.getLong(pvs[2])
autoRatio = PVUtil.getLong(pvs[3])

ratio = 1.0

widget.setPropertyValue("data_width",sizex)
widget.setPropertyValue("data_height",sizey)
widget.setPropertyValue("x_axis.maximum",sizex)
widget.setPropertyValue("y_axis.maximum",sizey)

if autoScale == 0:
	widget.setPropertyValue("width",sizex)
	widget.setPropertyValue("height",sizey)
elif autoRatio == 1:
	if(sizex>sizey):
		ratio = float(sizey)/sizex
		widget_sizex = default_dimension
		widget_sizey = default_dimension * ratio
		print("widget sizey is ")
		print(widget_sizey)
	elif(sizey>sizex):
		ratio = float(sizex)/sizey
		widget_sizey = default_dimension
		widget_sizex = default_dimension * ratio
	else:
		widget_sizex = default_dimension
		widget_sizey = default_dimension

	widget.setPropertyValue("width",widget_sizex )
	widget.setPropertyValue("height",widget_sizey )

else:
	widget.setPropertyValue("width",default_dimension)
	widget.setPropertyValue("height",default_dimension)
]]></text>
        <pv_name>$(CAM):image1:ArraySize0_RBV</pv_name>
        <pv_name>$(CAM):image1:ArraySize1_RBV</pv_name>
        <pv_name>loc://FitToWindow</pv_name>
        <pv_name>loc://AutoRatio</pv_name>
        <pv_name>=1</pv_name>
      </script>
    </scripts>
    <tooltip>$(x_pv)</tooltip>
    <interpolation>0</interpolation>
    <color_mode>0</color_mode>
    <unsigned>true</unsigned>
    <cursor_crosshair>true</cursor_crosshair>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Raptor Eagle-XV</text>
    <x>5</x>
    <y>20</y>
    <width>190</width>
    <height>30</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <file>camera_settings.bob</file>
    <x>490</x>
    <y>70</y>
    <width>380</width>
    <height>485</height>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
# widget.setPropertyValue('text', PVUtil.getString(pvs[0]))
minimum_posX = 490
autoScale = PVUtil.getLong(pvs[1])
if(autoScale == 0):
	posX = PVUtil.getLong(pvs[0])
	if posX > (minimum_posX - 10):
		widget.setPropertyValue("x",posX +10)
else:
	widget.setPropertyValue("x",minimum_posX )]]></text>
        <pv_name>$(CAM):image1:ArraySize0_RBV</pv_name>
        <pv_name>loc://FitToWindow</pv_name>
        <pv_name>=1</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box</name>
    <pv_name>loc://FitToWindow&lt;Long&gt;(1)</pv_name>
    <label>Fit to window</label>
    <x>310</x>
    <y>70</y>
    <width>90</width>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box_1</name>
    <pv_name>loc://AutoRatio&lt;Long&gt;(0)</pv_name>
    <label>Auto Ratio</label>
    <x>405</x>
    <y>70</y>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="11.0">
      </font>
    </font>
    <rules>
      <rule name="Enable" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>false</value>
        </exp>
        <exp bool_exp="pv0 == 1">
          <value>true</value>
        </exp>
        <pv_name>loc://FitToWindow</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="polygon" version="2.0.0">
    <name>Polygon</name>
    <x>450</x>
    <y>80</y>
    <width>0</width>
    <height>0</height>
    <points>
      <point x="0.0" y="0.0">
      </point>
    </points>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>loc://ColourMap&lt;VString&gt;("GRAY")</pv_name>
    <x>340</x>
    <y>10</y>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>Combo Box</name>
    <pv_name>loc://ColourMap&lt;VString&gt;("GRAY")</pv_name>
    <x>540</x>
    <y>20</y>
    <width>90</width>
    <height>20</height>
    <items>
      <item>GRAY</item>
      <item>JET</item>
    </items>
  </widget>
</display>
