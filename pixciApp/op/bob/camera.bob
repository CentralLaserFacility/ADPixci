<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <macros>
    <CAM>13PS1</CAM>
  </macros>
  <width>870</width>
  <height>560</height>
  <widget type="rectangle" version="2.0.0">
    <name>Rectangle</name>
    <x>20</x>
    <y>65</y>
    <width>465</width>
    <height>28</height>
    <line_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </line_color>
    <background_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
  </widget>
  <widget type="image" version="2.0.0">
    <name>Image</name>
    <pv_name>$(CAM):image1:ArrayData</pv_name>
    <x>5</x>
    <y>60</y>
    <width>480</width>
    <height>480</height>
    <show_toolbar>true</show_toolbar>
    <color_map>
      <name>GRAY</name>
    </color_map>
    <color_bar>
      <visible>false</visible>
      <bar_size>40</bar_size>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </color_bar>
    <x_axis>
      <visible>true</visible>
      <title></title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </x_axis>
    <y_axis>
      <visible>true</visible>
      <title></title>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
    </y_axis>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

# widget.setPropertyValue('text', PVUtil.getString(pvs[0]))

default_dimension = 480
sizex = PVUtil.getLong(pvs[0])
sizey = PVUtil.getLong(pvs[1])
widget_sizex = default_dimension
widget_sizey = default_dimension
autoScale = PVUtil.getLong(pvs[2])
autoRatio = PVUtil.getLong(pvs[3])

ratio = 1.0

widget.setPropertyValue("data_width",sizex)
widget.setPropertyValue("data_height",sizey)
widget.setPropertyValue("x_axis.maximum",sizex)
widget.setPropertyValue("y_axis.maximum",sizey)

if autoScale == 1:
	widget.setPropertyValue("width",sizex)
	widget.setPropertyValue("height",sizey)
elif autoRatio == 1:
	if(sizex>sizey):
		ratio = float(sizey)/sizex
		widget_sizex = default_dimension
		widget_sizey = default_dimension * ratio
		print("widget sizey is ")
		print(widget_sizey)
	elif(sizey>sizex):
		ratio = float(sizex)/sizey
		widget_sizey = default_dimension
		widget_sizex = default_dimension * ratio
	else:
		widget_sizex = default_dimension
		widget_sizey = default_dimension

	widget.setPropertyValue("width",widget_sizex )
	widget.setPropertyValue("height",widget_sizey )

else:
	widget.setPropertyValue("width",default_dimension)
	widget.setPropertyValue("height",default_dimension)
]]></text>
        <pv_name>$(CAM):image1:ArraySize0_RBV</pv_name>
        <pv_name>$(CAM):image1:ArraySize1_RBV</pv_name>
        <pv_name>loc://AutoScale</pv_name>
        <pv_name>loc://AutoRatio</pv_name>
        <pv_name>=1</pv_name>
      </script>
    </scripts>
    <tooltip>$(x_pv)</tooltip>
    <interpolation>0</interpolation>
    <color_mode>0</color_mode>
    <unsigned>true</unsigned>
    <autoscale>false</autoscale>
    <cursor_crosshair>true</cursor_crosshair>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Raptor Eagle-XV</text>
    <x>5</x>
    <y>20</y>
    <width>190</width>
    <height>30</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>Embedded Display</name>
    <file>camera_settings.bob</file>
    <x>490</x>
    <y>70</y>
    <width>390</width>
    <height>450</height>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
# widget.setPropertyValue('text', PVUtil.getString(pvs[0]))
minimum_posX = 490
autoScale = PVUtil.getLong(pvs[1])
if(autoScale == 1):
	posX = PVUtil.getLong(pvs[0])
	if posX > (minimum_posX - 10):
		widget.setPropertyValue("x",posX +10)
else:
	widget.setPropertyValue("x",minimum_posX )]]></text>
        <pv_name>$(CAM):image1:ArraySize0_RBV</pv_name>
        <pv_name>loc://AutoScale</pv_name>
        <pv_name>=1</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box</name>
    <pv_name>loc://AutoScale&lt;Long&gt;(0)</pv_name>
    <label>Auto Scale</label>
    <x>310</x>
    <y>70</y>
    <width>90</width>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box_1</name>
    <pv_name>loc://AutoRatio&lt;Long&gt;(0)</pv_name>
    <label>Auto Ratio</label>
    <x>400</x>
    <y>70</y>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
    <rules>
      <rule name="Enable" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>true</value>
        </exp>
        <exp bool_exp="pv0 == 1">
          <value>false</value>
        </exp>
        <pv_name>loc://AutoScale</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="write_pv">
        <pv_name>loc://export</pv_name>
        <value>1</value>
        <description>Write PV</description>
      </action>
    </actions>
    <pv_name>loc://export&lt;VLong&gt;(0)</pv_name>
    <text>Export</text>
    <x>500</x>
    <y>520</y>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil, FileUtil, ConsoleUtil
#from org.csstudio.opibuilder.scriptUtil import PVUtil, ConsoleUtil
from java.lang import Thread, Runnable
from javax.swing import SwingWorker
from org.csstudio.display.builder.model import Widget
local_trigger =  PVUtil.getDouble(pvs[0])
##### get data
rdata = PVUtil.getLongArray(pvs[1])
data = map(int, rdata)
sizex =  PVUtil.getLong(pvs[2])
sizey =  PVUtil.getLong(pvs[3])
png_pixel_limit = 255
if local_trigger == 1:
	#### open save as dialog box
	filePath = ScriptUtil.showSaveAsDialog(widget, "*.png")
	#print(filePath) #for debug purpose
	#### write data function
	def writeData():
		from java.awt.image import BufferedImage
		from java.awt import Color
		from java.io import File
		from javax.imageio import ImageIO

		f = File(filePath)
		img = BufferedImage(sizex ,sizey ,BufferedImage.TYPE_BYTE_GRAY)
		k=0
		for i in range(sizey):
			for j in range(sizex):
				val = data[k]
				# sanity check on values, overlays can cause values greater than
				# 255 and sometimes cameras have values less than 0
				if val < 0:
					val = 0
				if val > png_pixel_limit :
					val = png_pixel_limit
				#ConsoleUtil.writeInfo('pixel value =' + str(val))
				#ConsoleUtil.writeInfo(str(val))
				colour = Color(val,val,val)
				img.setRGB(j,i,colour.getRGB())
				k=k+1
		ImageIO.write(img, "png", f);
##### export in separate thread
class export(SwingWorker):
	def doInBackground(self):
		writeData()
	def done(self):
		pass

if local_trigger == 1:
	#### start thread
	export().execute()]]></text>
        <pv_name>loc://export</pv_name>
        <pv_name trigger="false">$(CAM):image1:ArrayData</pv_name>
        <pv_name trigger="false">$(CAM):image1:ArraySize0_RBV</pv_name>
        <pv_name trigger="false">$(CAM):image1:ArraySize1_RBV</pv_name>
      </script>
    </scripts>
    <tooltip>$(actions)</tooltip>
  </widget>
</display>
