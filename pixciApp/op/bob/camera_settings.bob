  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="write_pv">
        <pv_name>loc://export</pv_name>
        <value>1</value>
        <description>Write PV</description>
      </action>
    </actions>
    <pv_name>loc://export&lt;VLong&gt;(0)</pv_name>
    <text>Export</text>
    <x>8</x>
    <y>445</y>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil, FileUtil, ConsoleUtil
from java.lang import Thread, Runnable
from javax.swing import SwingWorker
from org.csstudio.display.builder.model import Widget
from java.awt.image import BufferedImage
from java.awt import Color
from java.io import File
from javax.imageio import ImageIO

local_trigger =  PVUtil.getDouble(pvs[0])
rdata = PVUtil.getLongArray(pvs[1])
sizex =  PVUtil.getLong(pvs[2])
sizey =  PVUtil.getLong(pvs[3])
	
filePath = ""

def writeData():
	#### write data function
	f = File(filePath)
	img = BufferedImage(sizex ,sizey ,BufferedImage.TYPE_BYTE_GRAY)
	k=0
	png_pixel_limit = 255	
	##### get data
	data = map(int, rdata)

	for i in range(sizey):
		for j in range(sizex):
			val = data[k]
			# sanity check on values, overlays can cause values greater than
			# 255 and sometimes cameras have values less than 0
			if val < 0:
				val = 0
			if val > png_pixel_limit :
				val = png_pixel_limit
			colour = Color(val,val,val)
			img.setRGB(j,i,colour.getRGB())
			k=k+1
	ImageIO.write(img, "png", f);


##### export in separate thread
class export(SwingWorker):
	def doInBackground(self):
		writeData()
	def done(self):
		pass

if local_trigger == 1:
	#### open save as dialog box
	filePath = ScriptUtil.showSaveAsDialog(widget, "*.png")
	#### start thread
	export().execute()]]></text>
        <pv_name>loc://export</pv_name>
        <pv_name trigger="false">$(CAM):image1:ArrayData</pv_name>
        <pv_name trigger="false">$(CAM):image1:ArraySize0_RBV</pv_name>
        <pv_name trigger="false">$(CAM):image1:ArraySize1_RBV</pv_name>
      </script>
    </scripts>
    <tooltip>$(actions)</tooltip>
  </widget>
</display>
