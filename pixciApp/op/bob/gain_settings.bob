<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <width>250</width>
  <height>250</height>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Pre Amp Gain</text>
    <x>10</x>
    <y>100</y>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box</name>
    <pv_name>$(CAM):cam1:ToggleGain</pv_name>
    <label></label>
    <x>115</x>
    <y>100</y>
    <width>30</width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(CAM):cam1:ToggleGain_RBV</pv_name>
    <x>135</x>
    <y>100</y>
  </widget>
</display>
