<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Display</name>
  <width>250</width>
  <height>250</height>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Fit to Window</text>
    <x>20</x>
    <y>90</y>
    <width>90</width>
    <font>
      <font name="Fine Print" family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_1</name>
    <text>Auto Ratio</text>
    <x>20</x>
    <y>120</y>
    <width>72</width>
    <font>
      <font name="Fine Print" family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_8</name>
    <text>Image Display</text>
    <x>20</x>
    <y>20</y>
    <width>130</width>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box</name>
    <pv_name>loc://FitToWindow</pv_name>
    <label></label>
    <x>168</x>
    <y>90</y>
    <width>72</width>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box_1</name>
    <pv_name>loc://AutoRatio&lt;Long&gt;(0)</pv_name>
    <label></label>
    <x>168</x>
    <y>120</y>
    <width>72</width>
    <rules>
      <rule name="Enable" prop_id="enabled" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>false</value>
        </exp>
        <exp bool_exp="pv0 == 1">
          <value>true</value>
        </exp>
        <pv_name>loc://FitToWindow</pv_name>
      </rule>
    </rules>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_2</name>
    <text>Colour Map</text>
    <x>20</x>
    <y>160</y>
    <width>72</width>
    <font>
      <font name="Fine Print" family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label_3</name>
    <text>Auto Scale</text>
    <x>20</x>
    <y>60</y>
    <font>
      <font name="Fine Print" family="Liberation Sans" style="REGULAR" size="12.0">
      </font>
    </font>
  </widget>
  <widget type="checkbox" version="2.0.0">
    <name>Check Box_2</name>
    <pv_name>loc://AutoScale&lt;Long&gt;(1)</pv_name>
    <label></label>
    <x>168</x>
    <y>60</y>
  </widget>
  <widget type="combo" version="2.0.0">
    <name>Combo Box</name>
    <pv_name>loc://ColourMap("GRAY")</pv_name>
    <x>110</x>
    <y>160</y>
    <width>110</width>
    <height>20</height>
    <items>
      <item>VIRIDIS</item>
      <item>JET</item>
      <item>GRAY</item>
      <item>SPECTRUM</item>
      <item>HOT</item>
      <item>COOL</item>
      <item>SHADED</item>
    </items>
    <items_from_pv>false</items_from_pv>
  </widget>
</display>
