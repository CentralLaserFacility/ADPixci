# RaptorEagleXV.template
# Database template for ADRaptorEagleXV, adds camera specific records,
# overrides some records from ADBase and ADPixci
#

include "Pixci.template"

################################################################################
# Override ADBase to extend Trigger Mode and RBV
#
record(mbbo, "$(P)$(R)TriggerMode")
{
   field(ZRST, "Live - ITR")
   field(ZRVL, "0")
   field(ONST, "Live - FFR")
   field(ONVL, "1")
   field(TWST, "Ext. Triggered")
   field(TWVL, "2")
   field(THST, "Btn. Triggered")
   field(THVL, "3")
   field(DISP, "1")
}

record(mbbi, "$(P)$(R)TriggerMode_RBV")
{
   field(ZRST, "Live - ITR")
   field(ZRVL, "0")
   field(ONST, "Live - FFR")
   field(ONVL, "1")
   field(TWST, "Ext. Triggered")
   field(TWVL, "2")
   field(THST, "Btn. Triggered")
   field(THVL, "3")
}

################################################################################
# Record for the temperature reading from the device PCB 
#
record(ai, "$(P)$(R)TemperaturePCB")
{
   field(DTYP, "asynFloat64")
   field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PR_TEMPERATURE_PCB")
   field(PREC, "1")
   field(EGU, "C")
   field(SCAN, "I/O Intr")
}

################################################################################
# Records related to ThermoElectric Cooling (TEC)
#
record(bo, "$(P)$(R)ToggleTEC")
{
   field(DTYP, "asynInt32")
   field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PR_TOGGLE_TEC")
   field(ZNAM, "Disabled")
   field(ONAM, "Enabled")
}

record(bi, "$(P)$(R)ToggleTEC_RBV")
{
   field(DTYP, "asynInt32")
   field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))PR_TOGGLE_TEC")
   field(ZNAM, "Disabled")
   field(ONAM, "Enabled")
   field(SCAN, "I/O Intr")
}

