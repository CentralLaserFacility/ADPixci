#RULES_FMT

override INSTALLS_FMT := $(FMT:%=$(INSTALL_FMT)/%)

$(INSTALL_FMT)/%.fmt: ../fmt/%/bin_1x1.fmt
	@echo "Installing FMT file: $@"
	@if not exist "$(dir $@)" mkdir "$(dir $@)"
	@if exist "$<" ( copy /Y $(subst /,\,$<) $(subst /,\,$@) ) else ( echo "Error: Source file $< not found!" && exit 1 )